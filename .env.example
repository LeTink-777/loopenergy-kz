# Copy to .env.local and fill in as each account is approved.
# Every integration checks its own keys at call time: present → live request,
# absent → realistic stub. See API_KEYS.md for how to obtain each one.

# ─── SITE ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://loopenergy.kz

# ─── CDEK ────────────────────────────────────────────────────────────────
# cdek.kz/ru/integration
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
NEXT_PUBLIC_CDEK_WIDGET_KEY=

# ─── KASPI DELIVERY ──────────────────────────────────────────────────────
# kaspi.kz/business after seller verification
KASPI_API_KEY=
KASPI_MERCHANT_ID=
NEXT_PUBLIC_KASPI_SHOP_ID=

# ─── KAZPOST ─────────────────────────────────────────────────────────────
# manager@kazpost.kz
KAZPOST_API_KEY=
KAZPOST_CONTRACT_ID=

# ─── FREEDOM PAY ─────────────────────────────────────────────────────────
# freedompay.kz/connect
FREEDOM_PAY_MERCHANT_ID=
FREEDOM_PAY_SECRET_KEY=
NEXT_PUBLIC_FREEDOM_PAY_PUBLIC_KEY=

# ─── KASPI PAY ───────────────────────────────────────────────────────────
# kaspi.kz/developers/pay
KASPI_PAY_PRIVATE_KEY=
NEXT_PUBLIC_KASPI_PAY_PUBLIC_KEY=

# ─── MAPS ────────────────────────────────────────────────────────────────
# developer.tech.yandex.ru — pickup point map
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# ─── ANALYTICS ───────────────────────────────────────────────────────────
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── DATABASE ────────────────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── EMAIL ───────────────────────────────────────────────────────────────
RESEND_API_KEY=
SMTP_FROM=orders@loopenergy.kz

# ─── TELEGRAM ────────────────────────────────────────────────────────────
# Order notifications to the manager
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
